rules_version = '2';

// Règles du classement en ligne de Bousier.
// Tout le monde peut lire ; chacun ne peut écrire que ses propres documents
// (id « uid_pseudo »), avec des valeurs plausibles. À copier dans la console
// Firebase : Firestore Database > Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function mine(id) {
      return request.auth != null && id.matches(request.auth.uid + '_.+');
    }
    function okName(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 14;
    }
    function okScore(v) {
      return v is number && v >= 0 && v <= 5000;
    }
    // Le jour (« AAAA-MM-JJ ») doit être aujourd'hui, à quelques heures près
    // pour couvrir tous les fuseaux horaires.
    function isToday(day) {
      let p = day.split('-');
      let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.time > t - duration.value(14, 'h')
        && request.time < t + duration.value(38, 'h');
    }

    match /envs/{env}/days/{day}/scores/{id} {
      allow read: if true;
      allow write: if (env == 'prod' || env == 'dev') && mine(id) && isToday(day)
        && okName(request.resource.data) && okScore(request.resource.data.score)
        && (resource == null || request.resource.data.score >= resource.data.score);
    }

    match /envs/{env}/days/{day}/ghosts/{id} {
      allow read: if true;
      allow write: if (env == 'prod' || env == 'dev') && mine(id) && isToday(day)
        && okName(request.resource.data) && okScore(request.resource.data.score)
        && request.resource.data.x is list && request.resource.data.x.size() <= 20000
        && request.resource.data.y is list && request.resource.data.y.size() <= 20000
        && request.resource.data.r is list && request.resource.data.r.size() <= 20000;
    }

    match /envs/{env}/players/{id} {
      allow read: if true;
      allow write: if (env == 'prod' || env == 'dev') && mine(id)
        && okName(request.resource.data) && okScore(request.resource.data.best)
        && request.resource.data.bestStreak is int && request.resource.data.bestStreak >= 0;
    }
  }
}
